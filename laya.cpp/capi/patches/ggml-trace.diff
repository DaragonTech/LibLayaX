diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
index 87a329f..622132d 100644
--- a/src/ggml-cpu/ggml-cpu.c
+++ b/src/ggml-cpu/ggml-cpu.c
@@ -3856,15 +3856,27 @@ int ggml_cpu_has_sme2(void) {
 #endif
 }
 
+// LAYA_DEBUG=1 progress lines (diagnostic patch, see capi/patches/ggml-trace.diff)
+static void laya_ggml_trace(const char * text, int value) {
+    const char * flag = getenv("LAYA_DEBUG");
+    if (!flag || !*flag || *flag == '0') return;
+    fprintf(stderr, "[laya] ggml: %s %d\n", text, value);
+    fflush(stderr);
+}
+
 void ggml_cpu_init(void) {
+    laya_ggml_trace("cpu_init: enter", 0);
     // needed to initialize ggml_time
     {
         struct ggml_init_params params = { 0, NULL, false };
         struct ggml_context * ctx = ggml_init(params);
+        laya_ggml_trace("cpu_init: ggml_init returned", ctx != NULL);
         ggml_free(ctx);
     }
 
+    laya_ggml_trace("cpu_init: taking the lock", 0);
     ggml_critical_section_start();
+    laya_ggml_trace("cpu_init: lock taken", 0);
 
     static bool is_first_call = true;
 
@@ -3874,6 +3886,7 @@ void ggml_cpu_init(void) {
             const uint64_t t_start = ggml_time_us(); UNUSED(t_start);
 
             for (int i = 0; i < (1 << 16); ++i) {
+                if ((i & 0xfff) == 0) laya_ggml_trace("cpu_init: half-float tables, entry", i);
                 union {
                     uint16_t u16;
                     ggml_fp16_t fp16;
@@ -3916,6 +3929,7 @@ void ggml_cpu_init(void) {
 #endif
         }
 
+        laya_ggml_trace("cpu_init: tables done", 0);
 #if defined(__ARM_ARCH)
         ggml_init_arm_arch_features();
 #endif
@@ -3933,4 +3947,5 @@ void ggml_cpu_init(void) {
     }
 
     ggml_critical_section_end();
+    laya_ggml_trace("cpu_init: done", 0);
 }
