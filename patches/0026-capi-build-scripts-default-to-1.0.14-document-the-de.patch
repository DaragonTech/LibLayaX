From 347007f606d824d0db44f1d20d48e0704559c872 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 2 Oct 2026 01:03:09 +0100
Subject: [PATCH 26/30] capi: build scripts default to 1.0.14; document the
 device option

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LAsYHSSgSysMFa8MKPJWgL
---
 capi/README.md                      | 5 +++--
 scripts/capi/build-linux.sh         | 2 +-
 scripts/capi/build-macos.sh         | 2 +-
 scripts/capi/build-windows-mingw.sh | 2 +-
 4 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/capi/README.md b/capi/README.md
index 61ccf36..3568497 100644
--- a/capi/README.md
+++ b/capi/README.md
@@ -33,8 +33,9 @@ laya_destroy(a);
 Options for `laya_create` (all optional): `backend` `cpu`|`cuda`|`vulkan`; `variant`
 `english`|`multilingual`|`typed-decisions` (picks `<dir>/<variant>` when `dir` is a model-store
 root); `precision` `fp32`|`fp16`|`bf16`; `flash`, `tensor_core` (the fast CUDA path is both
-`true`); `allow_truncation`; `threads` (CPU worker threads, default all cores). Unknown keys
-are rejected, so typos fail loudly.
+`true`); `allow_truncation`; `threads` (CPU worker threads, default all cores); `device`
+(Vulkan GPU: an index, or part of its name such as `"RTX"`; default is the first discrete
+GPU). Unknown keys are rejected, so typos fail loudly.
 
 ## Behaviour that matters to a host application
 
diff --git a/scripts/capi/build-linux.sh b/scripts/capi/build-linux.sh
index cdd3adf..dd434fd 100755
--- a/scripts/capi/build-linux.sh
+++ b/scripts/capi/build-linux.sh
@@ -21,7 +21,7 @@ ICU_VERSION=${ICU_VERSION:-76-1}
 ICU_TGZ=icu4c-${ICU_VERSION/-/_}-src.tgz
 JOBS=${JOBS:-$(nproc)}
 VARIANTS=${VARIANTS:-"avx2 compat"}
-VERSION=${LAYA_C_VERSION:-1.0.9}
+VERSION=${LAYA_C_VERSION:-1.0.14}
 mkdir -p "$WORK" && cd "$WORK"
 
 # 1. Static, position-independent ICU (the system one is a shared, version-specific library).
diff --git a/scripts/capi/build-macos.sh b/scripts/capi/build-macos.sh
index 0702d52..50d138e 100755
--- a/scripts/capi/build-macos.sh
+++ b/scripts/capi/build-macos.sh
@@ -14,7 +14,7 @@ set -euo pipefail
 ROOT=$(cd "$(dirname "$0")/../.." && pwd)
 WORK=${WORK:-$ROOT/build-deps}
 JOBS=${JOBS:-$(nproc)}
-VERSION=${LAYA_C_VERSION:-1.0.5}
+VERSION=${LAYA_C_VERSION:-1.0.14}
 ICU_VERSION=${ICU_VERSION:-76-1}
 ICU_TGZ=icu4c-${ICU_VERSION/-/_}-src.tgz
 if [ -z "${ZIG:-}" ]; then
diff --git a/scripts/capi/build-windows-mingw.sh b/scripts/capi/build-windows-mingw.sh
index 9285667..7250d0d 100755
--- a/scripts/capi/build-windows-mingw.sh
+++ b/scripts/capi/build-windows-mingw.sh
@@ -45,7 +45,7 @@ fi
 #           (SPIRV-Headers/include), GLSLC (shaderc >= 2025.3) and VULKAN_DEF (a .def listing the
 #           exports of vulkan-1.dll, e.g. generated from Wine's or the SDK's vulkan-1.dll).
 I=$WORK/icu-win
-VERSION=${LAYA_C_VERSION:-1.0.9}
+VERSION=${LAYA_C_VERSION:-1.0.14}
 for variant in ${VARIANTS:-avx2 compat}; do
   cxxflags="-DU_STATIC_IMPLEMENTATION"
   case $variant in
