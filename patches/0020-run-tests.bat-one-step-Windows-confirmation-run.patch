Subject: [PATCH 20/30] run-tests.bat: one-step Windows confirmation run

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LAsYHSSgSysMFa8MKPJWgL
---
 scripts/capi/run-tests.bat | 81 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 81 insertions(+)
 create mode 100644 scripts/capi/run-tests.bat

diff --git a/scripts/capi/run-tests.bat b/scripts/capi/run-tests.bat
new file mode 100644
index 0000000..8f05054
--- /dev/null
+++ b/scripts/capi/run-tests.bat
@@ -0,0 +1,81 @@
+@echo off
+rem laya.dll 1.0.9 - confirmation run. Put this file next to laya.dll and run:
+rem     run-tests.bat MODEL_FOLDER [cpu^|vulkan]
+rem Example: run-tests.bat E:\Garbage\!laya\convaiinnovations@laya
+rem Results are shown and saved to laya-test-log.txt in this folder.
+setlocal DisableDelayedExpansion
+cd /d "%~dp0"
+
+set "MODEL=%~1"
+if "%MODEL%"=="" set /p "MODEL=Model folder (contains rl_agent_config.json): "
+rem Normalise the path: full path, no trailing backslash (a trailing \ would escape the closing quote).
+for %%I in ("%MODEL%\.") do set "MODEL=%%~fI"
+if "%MODEL:~-1%"=="\" set "MODEL=%MODEL:~0,-1%"
+set "BACKEND=%~2"
+if "%BACKEND%"=="" set "BACKEND=cpu"
+
+if not exist "laya.dll" (
+  echo laya.dll is not in this folder: %CD%
+  exit /b 2
+)
+if not exist "%MODEL%\rl_agent_config.json" (
+  echo No model found at: %MODEL%
+  echo ^(expected rl_agent_config.json there^)
+  exit /b 2
+)
+
+set "LOG=%CD%\laya-test-log.txt"
+set LAYA_CRASH_REPORT=1
+set "LAYA_TEST_MODEL=%MODEL%"
+set "LAYA_TEST_BACKEND=%BACKEND%"
+set FAILED=0
+
+> "%LOG%" echo laya.dll confirmation run, backend %BACKEND%
+>> "%LOG%" echo model: %MODEL%
+>> "%LOG%" echo.
+
+echo [1/3] C test suite ...
+>> "%LOG%" echo ===== 1. test-capi.exe =====
+test-capi.exe >> "%LOG%" 2>&1
+set RC1=%ERRORLEVEL%
+if not "%RC1%"=="0" set FAILED=1
+>> "%LOG%" echo exit code %RC1%
+>> "%LOG%" echo.
+
+echo [2/3] Pascal binding ...
+>> "%LOG%" echo ===== 2. LayaTests.exe =====
+LayaTests.exe "%MODEL%" %BACKEND% >> "%LOG%" 2>&1
+set RC2=%ERRORLEVEL%
+if not "%RC2%"=="0" set FAILED=1
+>> "%LOG%" echo exit code %RC2%
+>> "%LOG%" echo.
+
+echo [3/3] Speed ...
+>> "%LOG%" echo ===== 3. laya-bench.exe =====
+if /i "%BACKEND%"=="cpu" (
+  laya-bench.exe "%MODEL%" "{\"backend\":\"cpu\"}" >> "%LOG%" 2>&1
+) else (
+  laya-bench.exe "%MODEL%" >> "%LOG%" 2>&1
+)
+set RC3=%ERRORLEVEL%
+if not "%RC3%"=="0" set FAILED=1
+>> "%LOG%" echo exit code %RC3%
+
+if exist laya-crash.txt (
+  >> "%LOG%" echo.
+  >> "%LOG%" echo ===== laya-crash.txt =====
+  type laya-crash.txt >> "%LOG%"
+  set FAILED=1
+)
+
+echo.
+type "%LOG%"
+echo.
+echo ------------------------------------------------------------
+if "%FAILED%"=="0" (
+  echo RESULT: ALL PASSED   ^(test-capi %RC1%, LayaTests %RC2%, laya-bench %RC3%^)
+) else (
+  echo RESULT: SOMETHING FAILED   ^(test-capi %RC1%, LayaTests %RC2%, laya-bench %RC3%^)
+)
+echo Log saved to %LOG%
+endlocal & exit /b %FAILED%
